<idea-plugin>
    <id>com.kgboard.rgb.ui-probe</id>
    <name>KGBoard native test observer</name>
    <version>0.0.1</version>
    <idea-version since-build="263" until-build="263.*"/>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.java</depends>
    <depends>com.kgboard.rgb</depends>
    <depends>org.jetbrains.plugins.gradle</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.kgboard.rgb.probe.BuildProbe"/>
    </extensions>
</idea-plugin>
